{
  "name": "ajisai",
  "version": "0.1.0",
  "description": "Next-generation lightweight ETL platform",
  "main": "./out/main/index.js",
  "author": "Kentaro Tanabe",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/k-nasa/ajisai",
  "repository": {
    "type": "git",
    "url": "https://github.com/k-nasa/ajisai.git"
  },
  "scripts": {
    "dev": "electron-vite",
    "build": "electron-vite build && electron-builder",
    "build:dir": "electron-vite build && electron-builder --dir",
    "preview": "electron-vite preview",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "electron-updater": "^6.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "^5.0.0",
    "zundo": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.example.ajisai",
    "productName": "ajisai",
    "files": [
      "out/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "out": "out",
      "buildResources": "assets"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "sign": false,
      "notarize": false
    },
    "win": {
      "target": ["nsis", "portable"],
      "certificateFile": null,
      "certificatePassword": null
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "k-nasa",
      "repo": "ajisai"
    }
  }
}
